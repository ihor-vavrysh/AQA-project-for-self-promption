{
  "name": "tutorforge",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @tutorforge/shared build && pnpm --filter @tutorforge/api test:e2e",
    "test:e2e": "pnpm --filter @tutorforge/e2e e2e",
    "db:generate": "pnpm --filter @tutorforge/api db:generate",
    "db:migrate": "pnpm --filter @tutorforge/api db:migrate",
    "api:generate": "pnpm --filter @tutorforge/shared build && pnpm --filter @tutorforge/api openapi:export && pnpm --filter @tutorforge/openapi-codegen generate",
    "api:check": "pnpm api:generate && git diff --exit-code -- apps/api/openapi.json apps/web/src/app/core/api/api.generated.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "^2.5.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.38.0"
  }
}
