      "checkConstraints": {
        "resources_licence_matches_usage_tier": {
          "name": "resources_licence_matches_usage_tier",
          "value": "(\n        (\"resources\".\"licence\" in ('cc0', 'public-domain', 'cc-by', 'cc-by-sa') and \"resources\".\"usage_tier\" = 'open')\n        or (\"resources\".\"licence\" = 'platform-tos' and \"resources\".\"usage_tier\" = 'embed')\n        or (\"resources\".\"licence\" = 'proprietary' and \"resources\".\"usage_tier\" = 'commercial')\n      )"
        },
        "resources_commercial_links_only": {
          "name": "resources_commercial_links_only",
          "value": "\"resources\".\"usage_tier\" <> 'commercial' or (\"resources\".\"embed_url\" is null and \"resources\".\"mirrored_path\" is null)"
        },
        "resources_embed_tier_requires_embed_url": {
          "name": "resources_embed_tier_requires_embed_url",
          "value": "\"resources\".\"usage_tier\" <> 'embed' or (\"resources\".\"embed_url\" is not null and \"resources\".\"mirrored_path\" is null)"
        },
        "resources_affiliate_commercial_only": {
          "name": "resources_affiliate_commercial_only",
          "value": "\"resources\".\"affiliate_url\" is null or \"resources\".\"usage_tier\" = 'commercial'"
        },
        "resources_attribution_present_when_required": {
          "name": "resources_attribution_present_when_required",
          "value": "\"resources\".\"licence\" not in ('cc-by', 'cc-by-sa')\n        or (\"resources\".\"attribution_text\" is not null and btrim(\"resources\".\"attribution_text\") <> '')"
        }
      },
      "isRLSEnabled": false
    },
