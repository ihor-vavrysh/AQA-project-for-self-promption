  "info": {
    "title": "TutorForge API",
    "description": "Tutor-facing content platform API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LearnerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "pseudonym": {
            "type": "string",
            "maxLength": 40,
            "description": "Pseudonymous handle; do not use a real name"
          },
          "ageBand": {
            "type": "string",
            "enum": [
              "5-7",
              "8-10",
              "11-13",
              "14-16",
              "17-18"
            ]
          },
          "locale": {
            "type": "string",
            "maxLength": 20,
            "example": "en-GB"
          },
          "curriculumCode": {
            "type": "string",
            "maxLength": 40,
            "example": "KS3"
          },
          "interests": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "learningPreference": {
            "type": "string",
            "enum": [
              "visual",
              "narrative",
              "step-by-step",
              "challenge-first"
            ]
          },
          "confidenceLevel": {
            "type": "string",
            "enum": [
              "low",
              "developing",
              "confident",
              "high"
            ]
          },
          "attentionSpan": {
            "type": "string",
            "enum": [
              "under-10-minutes",
              "10-20-minutes",
              "over-20-minutes"
            ]
          },
          "gender": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "subject": {
            "type": "string",
            "maxLength": 80
          },
          "level": {
            "type": "string",
            "maxLength": 80
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "pseudonym",
          "ageBand",
          "locale",
          "curriculumCode",
          "interests",
          "learningPreference",
          "confidenceLevel",
          "attentionSpan",
          "gender",
          "subject",
          "level",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateLearnerDto": {
        "type": "object",
        "properties": {
          "pseudonym": {
            "type": "string",
            "maxLength": 40,
