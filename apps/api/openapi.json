            "description": "Mentee profile not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a mentee profile belonging to the authenticated tutor",
        "tags": [
          "learners"
        ]
      },
      "patch": {
        "operationId": "LearnersController_update",
        "parameters": [
          {
            "name": "learnerId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLearnerDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerDto"
                }
              }
            }
          },
          "400": {
            "description": "Request validation failed or identifier is invalid"
          },
          "401": {
            "description": "A valid Auth0 access token is required"
          },
          "404": {
            "description": "Mentee profile not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update a mentee profile belonging to the authenticated tutor",
        "tags": [
          "learners"
        ]
      },
      "delete": {
        "operationId": "LearnersController_remove",
        "parameters": [
          {
            "name": "learnerId",
            "required": true,
