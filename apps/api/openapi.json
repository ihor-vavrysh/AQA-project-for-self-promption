          },
          "interests": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "learningPreference": {
            "type": "string",
            "enum": [
              "visual",
              "narrative",
              "step-by-step",
              "challenge-first"
            ]
          },
          "confidenceLevel": {
            "type": "string",
            "enum": [
              "low",
              "developing",
              "confident",
              "high"
            ]
          },
          "attentionSpan": {
            "type": "string",
            "enum": [
              "under-10-minutes",
              "10-20-minutes",
              "over-20-minutes"
            ]
          },
          "gender": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "subject": {
            "type": "string",
            "maxLength": 80
          },
          "level": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "pseudonym",
          "ageBand",
          "locale",
          "curriculumCode",
          "interests",
          "learningPreference",
          "confidenceLevel",
          "attentionSpan",
          "gender",
          "subject",
          "level"
        ]
      },
      "UpdateLearnerDto": {
        "type": "object",
        "properties": {
          "pseudonym": {
            "type": "string",
            "maxLength": 40
          },
          "ageBand": {
            "type": "string",
            "enum": [
              "5-7",
              "8-10",
              "11-13",
              "14-16",
              "17-18"
            ]
          },
          "locale": {
            "type": "string",
            "maxLength": 20
          },
          "curriculumCode": {
            "type": "string",
            "maxLength": 40
          },
          "interests": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "learningPreference": {
            "type": "string",
            "enum": [
              "visual",
