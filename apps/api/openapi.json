            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Mentee profile deleted"
          },
          "400": {
            "description": "Request validation failed or identifier is invalid"
          },
          "401": {
            "description": "A valid Auth0 access token is required"
          },
          "404": {
            "description": "Mentee profile not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
