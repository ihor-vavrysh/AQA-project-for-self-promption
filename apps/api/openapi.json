              "step-by-step",
              "challenge-first"
            ]
          },
          "confidenceLevel": {
            "type": "string",
            "enum": [
              "low",
              "developing",
              "confident",
              "high"
            ]
          },
          "attentionSpan": {
            "type": "string",
            "enum": [
              "under-10-minutes",
              "10-20-minutes",
              "over-20-minutes"
            ]
          },
          "gender": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "subject": {
            "type": "string",
            "maxLength": 80
          },
          "level": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "createdAt"
        ]
      }
    }
  }
}
